# Copy to .env (`uv run poe init-env` does this and generates secrets) and adjust.
# Never commit .env. Docker Compose reads it for both variable interpolation and the
# container environment; local tools (alembic, pytest, app.cli) read it via pydantic-settings.

# --- General -----------------------------------------------------------------------------
# dev | prod. In prod, JWT_SECRET must be strong and registration defaults to off.
ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------------------
# Inside compose, POSTGRES_HOST is forced to "db". "localhost" is for tools run on the host
# (e.g. `uv run poe revision`) against the dev DB, which is published on 127.0.0.1 only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes
# Host port for the dev DB (compose.override.yaml). Change it if 5432 is already taken, and
# set POSTGRES_PORT to the same value for host tools.
POSTGRES_HOST_PORT=5432
# SQLAlchemy pool per worker process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth --------------------------------------------------------------------------------
# HMAC secret for JWTs. Required. In prod: at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 7 days
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Self-service POST /api/v1/auth/register. Unset = true in dev, false in prod.
# ALLOW_REGISTRATION=false

# --- HTTP --------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins (empty = CORS disabled).
CORS_ORIGINS=
# Uvicorn worker processes per web container (prod; dev runs one worker with --reload).
WEB_CONCURRENCY=2
# Which proxy IPs uvicorn trusts for X-Forwarded-* headers. "*" is safe here because the web
# container is reachable only through Traefik on the private "proxy" network.
FORWARDED_ALLOW_IPS=*

# --- Production (compose.prod.yaml) --------------------------------------------------------
# Public hostname of the API, and the contact email for Let's Encrypt.
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
